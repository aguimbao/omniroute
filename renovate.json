{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitScope(deps)"
  ],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "matchPackageNames": ["*"]
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Containerfile base image updater",
      "managerFilePatterns": ["/(^|/)Containerfile.*$/"],
      "matchStrings": [
        "FROM (?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Mise dev stack image updater",
      "managerFilePatterns": ["/(^|/)\\.mise\\.dev\\.toml$/"],
      "matchStrings": [
        "const OMNIROUTE_IMAGE = [\"'](?<depName>[^:\\s\"']+):(?<currentValue>[^@\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pitchfork daemon image updater",
      "managerFilePatterns": ["/(^|/)pitchfork\\.toml$/"],
      "matchStrings": [
        "(?:run = \"[^\"]*\\s)(?<depName>[a-z0-9._/-]+):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\s"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Act runner image updater",
      "managerFilePatterns": ["/(^|/)\\.actrc$/"],
      "matchStrings": [
        "-P\\s+[a-zA-Z0-9._-]+=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "hk.pkl package version updater",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/(?<depName>jdx/hk)/releases/download/v(?<currentValue>[^/]+)/hk@(?<currentVersion>[^#]+)#/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "mise": {
    "managerFilePatterns": ["/(^|/)\\.mise.*\\.toml$/"]
  }
}
