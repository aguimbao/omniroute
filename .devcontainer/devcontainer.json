{
  "name": "omniroute",
  "build": {
    "dockerfile": "Containerfile"
  },
  "runArgs": [
    "--device=/dev/fuse",
    "--device=/dev/net/tun",
    "--security-opt=label=disable",
    "--security-opt=seccomp=unconfined",
    "--security-opt=unmask=ALL",
    "--userns=keep-id"
  ],
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "postCreateCommand": "mise install node bun && mise install && hk install",
  "forwardPorts": [20128, 20132, 20228, 20232]
}
